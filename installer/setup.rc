#include "resource.h"

IDI_APP_ICON ICON "..\\assets\\xiaoyue.ico"
IDR_PAYLOAD_CAB RCDATA "..\\build\\setup-payload\\quietpdf-payload.cab"
IDR_WELCOME_ART RCDATA "assets\\welcome_pdf.png"
IDR_LICENSE_TEXT RCDATA "..\\LICENSE"

#include "..\version.h"

1 VERSIONINFO
 FILEVERSION QINGYUE_VERSION_TUPLE
 PRODUCTVERSION QINGYUE_VERSION_TUPLE
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "QingYue"
            VALUE "FileDescription", "QingYue PDF Installer"
            VALUE "FileVersion", QINGYUE_VERSION_FILE_STRING
            VALUE "InternalName", "QingYuePDF.Setup"
            VALUE "OriginalFilename", "QingYuePDF-Setup-x64.exe"
            VALUE "ProductName", "QingYue PDF"
            VALUE "ProductVersion", QINGYUE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
