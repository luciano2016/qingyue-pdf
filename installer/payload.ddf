.OPTION EXPLICIT
.Set CabinetNameTemplate=quietpdf-payload.cab
.Set DiskDirectoryTemplate=build\setup-payload
.Set Cabinet=on
.Set Compress=on
.Set CompressionType=LZX
.Set CompressionMemory=21
.Set MaxDiskSize=0
.Set DiskDirectory1=build\setup-payload

"build\setup-input\QuietPDF.Win32.exe" "QuietPDF.Win32.exe"
"build\setup-input\quietmupdf.dll" "quietmupdf.dll"
"build\setup-input\vcruntime140.dll" "vcruntime140.dll"
"build\setup-input\QingYuePDF.Uninstaller.exe" "QingYuePDF.Uninstaller.exe"

"build\setup-input\LICENSE" "LICENSE"
"build\setup-input\THIRD_PARTY_NOTICES.md" "THIRD_PARTY_NOTICES.md"
"build\setup-input\MUPDF_THIRD_PARTY_LICENSES.txt" "MUPDF_THIRD_PARTY_LICENSES.txt"
"build\setup-input\GPL-3.0.txt" "GPL-3.0.txt"
